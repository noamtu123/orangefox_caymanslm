diff --git a/gui/battery.cpp b/gui/battery.cpp
index 9fca830c..2671af8f 100644
--- a/gui/battery.cpp
+++ b/gui/battery.cpp
@@ -184,16 +184,26 @@ int GUIBattery::Update(void)
 	if (!isConditionTrue())
 		return 0;
 
-	const uint_fast8_t threshold = 16;
-	static uint_fast8_t updateCounter = threshold;
-
-	// update the battery info on the status bar
-	if (updateCounter)
-		updateCounter--;
-	else {
-		updateCounter = threshold;
-		return 2;
-	}
+	// Redraw only when something actually changed. The old code ignored the
+	// values and unconditionally requested a full redraw every 17th call, so a
+	// real change had to wait for the next slot instead of the next tick. That
+	// slot is long: once nothing on screen is animating, runPages() raises the
+	// input timeout to 1s, which stretched the window to ~2s and made the charge
+	// icon lag a cable pull by about that much. Comparing the values instead
+	// reacts on the first tick after the monitor thread publishes a new state,
+	// and returns 0 the rest of the time -- fewer idle redraws than before, not
+	// more. GUIText::Update() already refreshes the clock on its own counter, so
+	// nothing else depended on this periodic redraw.
+	const int batteryPercent = DataManager::GetIntValue("tw_battery");
+	const int batteryCharge = DataManager::GetIntValue("charging_now");
+	const int batteryIcon = DataManager::GetIntValue("enable_battery");
+
+	if (batteryPercent == mLastPercent && batteryCharge == mLastCharge
+			&& batteryIcon == mLastIcon)
+		return 0;
 
-	return 0;
+	mLastPercent = batteryPercent;
+	mLastCharge = batteryCharge;
+	mLastIcon = batteryIcon;
+	return 2;
 }
diff --git a/gui/gui.cpp b/gui/gui.cpp
index 71bbc967..1bbe29b1 100644
--- a/gui/gui.cpp
+++ b/gui/gui.cpp
@@ -725,7 +725,16 @@ static int runPages(const char *page_name, const int stop_on_page_done)
 			else
 				idle_frames = 0;
 			// due to possible animation objects, we need to delay activating the input timeout
-			input_timeout_ms = idle_frames > 15 ? 1000 : 0;
+			// Idle wait was 1000ms, which set the floor on how fast anything
+			// published by a background thread could reach the screen: with
+			// nothing on screen animating, the loop simply slept through the
+			// change. Measured on this device, the kernel reports a charger
+			// plug/unplug in under 134ms and the battery monitor thread polls
+			// every 250ms, so a 1s idle wait was by far the largest term in the
+			// visible lag. 250ms keeps the loop asleep essentially as much
+			// (four cheap poll wakeups a second, each returning immediately
+			// once every object reports "unchanged") while bounding that lag.
+			input_timeout_ms = idle_frames > 15 ? 250 : 0;
 
 #ifndef PRINT_RENDER_TIME
 			if (ret > 1)
