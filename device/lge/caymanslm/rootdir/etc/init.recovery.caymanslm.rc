import /init.recovery.qcom_decrypt.rc

on early-init
    setprop sys.usb.configfs 1

on init
    # TWRP's partition manager only resolves top-level mount points. Mount the
    # partition as /persist and retain Qualcomm/LG's expected vendor path as a
    # symlink for qseecomd, keymaster, DRM, and time-services clients.
    mkdir /persist 0771 root system
    mkdir /mnt/vendor 0755 root root
    symlink /persist /mnt/vendor/persist

    # Force prepdecrypt to set OS version + security-patch level from the
    # INSTALLED ROM's system/vendor build.prop instead of leaving recovery's own.
    # This device has a dedicated recovery partition, so prepdecrypt.sh defaults
    # SETPATCH=false and never corrects the patchlevel; keymaster then boots with
    # recovery's wrong values (os=11, patch=2024-09-05, vendor=empty->0) and
    # rejects the stock FBE key's upgradeKey() with INVALID_ARGUMENT (-38),
    # blocking decrypt. Setting this prop here (before prepdecrypt runs, and it
    # runs before crypto.ready gates keymaster) makes prepdecrypt mount the stock
    # partitions and resetprop the real values (os=12, patch/vendor=2022-08-01),
    # so the key needs no upgrade and unwraps. Proven on-device 2026-07-22.
    setprop prepdecrypt.setpatch true
    # ~50% of the panel's real max (365), not the old wrong 255-scale value
    write /sys/class/backlight/panel0-backlight/brightness 180

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

# Migrate the old OrangeFox default saved by earlier builds. Fresh installs
# already use OF_DEFAULT_TIMEZONE; this exact trigger preserves any other
# timezone the user deliberately selects.
on property:persist.sys.timezone=CET-1;CEST,M3.5.0,M10.5.0
    setprop persist.sys.timezone IST-2IDT,M3.4.4/26,M10.5.0

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# Native crash capture. The base tombstoned module ships its own
# /system/etc/init/tombstoned.rc, but recovery init never imports it and its
# service has no start trigger, so it never runs. Define + start it here. With
# crash_dump64 in the ramdisk (see BoardConfig crash_dump.recovery), this makes
# native aborts (logd, keystore2, ...) produce tombstones. Read them by shadowing
# encrypted /data/tombstones with a tmpfs bind-mount at runtime.
on init
    start tombstoned

service tombstoned /system/bin/tombstoned
    class core
    user root
    group root system
    socket tombstoned_crash seqpacket 0666 root root
    socket tombstoned_intercept seqpacket 0666 root root
    socket tombstoned_java_trace seqpacket 0666 root root
    seclabel u:r:recovery:s0
