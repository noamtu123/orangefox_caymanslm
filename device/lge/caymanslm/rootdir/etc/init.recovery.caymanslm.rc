import /init.recovery.qcom_decrypt.rc

on early-init
    setprop sys.usb.configfs 1

on init
    # TWRP's partition manager only resolves top-level mount points. Mount the
    # partition as /persist and retain Qualcomm/LG's expected vendor path as a
    # symlink for qseecomd, keymaster, DRM, and time-services clients.
    mkdir /persist 0771 root system
    mkdir /mnt/vendor 0755 root root
    symlink /persist /mnt/vendor/persist

    # Force prepdecrypt to set OS version + security-patch level from the
    # INSTALLED ROM's system/vendor build.prop instead of leaving recovery's own.
    # This device has a dedicated recovery partition, so prepdecrypt.sh defaults
    # SETPATCH=false and never corrects the patchlevel; keymaster then boots with
    # recovery's wrong values (os=11, patch=2024-09-05, vendor=empty->0) and
    # rejects the stock FBE key's upgradeKey() with INVALID_ARGUMENT (-38),
    # blocking decrypt. Setting this prop here (before prepdecrypt runs, and it
    # runs before crypto.ready gates keymaster) makes prepdecrypt mount the stock
    # partitions and resetprop the real values (os=12, patch/vendor=2022-08-01),
    # so the key needs no upgrade and unwraps. Proven on-device 2026-07-22.
    setprop prepdecrypt.setpatch true
    # prepdecrypt is launched by recovery only after Process_Fstab has resolved
    # ro.crypto.type, so its generic one-second property-race grace period is
    # unnecessary on this device.
    setprop prepdecrypt.crypto_props_ready true
    # ~50% of the panel's real max (365), not the old wrong 255-scale value
    write /sys/class/backlight/panel0-backlight/brightness 180

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

# Migrate the old OrangeFox default saved by earlier builds. Fresh installs
# already use OF_DEFAULT_TIMEZONE; this exact trigger preserves any other
# timezone the user deliberately selects.
# keystore2's upstream late-init trigger races the Qualcomm secure-world
# services: it starts before qseecomd/keymaster, aborts, then init waits for a
# restart. The recovery overlay disables that early trigger. Start it only
# after the Keymaster 4 service is alive, which removes the failed attempt
# before automatic FBE decryption.
on property:init.svc.keymaster-4-0-qti=running
    start keystore2

on property:persist.sys.timezone=CET-1;CEST,M3.5.0,M10.5.0
    setprop persist.sys.timezone IST-2IDT,M3.4.4/26,M10.5.0

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice


# Native crash capture. The base tombstoned module ships its own
# /system/etc/init/tombstoned.rc, but recovery init never imports it and its
# service has no start trigger, so it never runs. Define + start it here. With
# crash_dump64 in the ramdisk (see BoardConfig crash_dump.recovery), this makes
# native aborts (logd, keystore2, ...) produce tombstones.
#
# The output directories deliberately live on the ramdisk, NOT on /data.
# tombstoned's CrashQueue opens its directory exactly once, in a static
# initializer (open(dir, O_DIRECTORY|O_RDONLY|O_CLOEXEC) in tombstoned.cpp), and
# writes every artifact through that fd with openat(). Whatever the path
# resolves to at process start is pinned for the life of the process, so
# resolving it through a ramdisk symlink keeps the fd off the userdata
# filesystem for good.
#
# Without this, /data/tombstones resolved onto the userdata f2fs and broke
# Format Data (found 2026-08-10):
#   * At `on init` /data is not mounted yet, so the open failed and tombstoned
#     hit PLOG(FATAL). Being `class core`, init restarted it in a loop until
#     OrangeFox mounted /data, at which point it succeeded and pinned an fd on
#     the f2fs superblock for the rest of the session.
#   * That made `umount /data` return EBUSY. TWPartition::UnMount then falls
#     back to `umount -l` and returns true, because Is_Mounted() only consults
#     /proc/mounts -- but a lazy unmount keeps the superblock, and therefore the
#     block device's bd_holder, alive. make_f2fs's O_EXCL open then failed with
#     "Error: In use by the system!" and Format Data died with ERROR: 255,
#     staying broken until the recovery rebooted.
# The `umount -l`-reports-success path is upstream OrangeFox behaviour and is
# still latent: any other process holding /data would reproduce it.
#
# Side benefit: tombstones are now readable at /tombstones and /anr whether or
# not /data is mounted or decrypted, which replaces the old workaround of
# shadowing encrypted /data/tombstones with a tmpfs bind-mount at runtime.
on early-init
    mkdir /tombstones 0755 root system
    mkdir /anr 0755 root system
    symlink /tombstones /data/tombstones
    symlink /anr /data/anr

on init
    start tombstoned

service tombstoned /system/bin/tombstoned
    class core
    user root
    group root system
    socket tombstoned_crash seqpacket 0666 root root
    socket tombstoned_intercept seqpacket 0666 root root
    socket tombstoned_java_trace seqpacket 0666 root root
    seclabel u:r:recovery:s0
