<?xml version="1.0" encoding="UTF-8"?>
<!--
  VINTF vendor manifest fragment for the bundled FBE decrypt HALs.
  OrangeFox (fox_14.1) reads android.hardware.keymaster from the vendor
  manifest to auto-select the keymaster service version to start in recovery.
  These match the G91030a (A11) vendor blobs bundled in this ramdisk.
-->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <version>4.0</version>
        <interface>
            <name>IKeymasterDevice</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.gatekeeper</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!--
      vendor.qti.hardware.qseecom@1.0 intentionally NOT declared here: its HIDL
      service binary is not bundled, and FBE reaches qseecom via libQSEEComAPI ->
      qseecomd (both present), not via the HIDL service. Re-add only if a bundled
      /vendor/bin/hw/vendor.qti.hardware.qseecom@1.0-service is proven required.
    -->
</manifest>
