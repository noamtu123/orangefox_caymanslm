# Android fstab for LG Velvet 4G (caymanslm).
system                                             /system_root             ext4    ro,barrier=1,discard                                                wait,slotselect,logical,first_stage_mount
product                                            /product                 ext4    ro,barrier=1,discard                                                wait,slotselect,logical,first_stage_mount
vendor                                             /vendor                  ext4    ro,barrier=1,discard                                                wait,slotselect,logical,first_stage_mount
/dev/block/bootdevice/by-name/userdata             /data                    f2fs    noatime,nosuid,nodev,discard,fsync_mode=nobarrier                    latemount,wait,check,formattable,fileencryption=ice,quota,reservedsize=128M,checkpoint=fs
/dev/block/by-name/metadata                        /metadata                ext4    noatime,nosuid,nodev,discard                                        wait,formattable
/dev/block/bootdevice/by-name/modem                /vendor/firmware_mnt     vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337            wait,slotselect
/dev/block/bootdevice/by-name/dsp                  /vendor/dsp              ext4    ro,nosuid,nodev,barrier=1                                           wait,slotselect
/dev/block/bootdevice/by-name/persist              /mnt/vendor/persist      ext4    nosuid,nodev,barrier=1,noatime,noauto_da_alloc,errors=continue       wait,check
/dev/block/by-name/drm                             /mnt/vendor/persist-lg   ext4    nosuid,nodev,barrier=1,noauto_da_alloc                              wait,check
/dev/block/bootdevice/by-name/p_persist_lg         /mnt/product/persist-lg  ext4    nosuid,nodev,barrier=1,noauto_da_alloc                              wait,check
/dev/block/bootdevice/by-name/misc                 /misc                    emmc    defaults                                                           defaults
/dev/block/bootdevice/by-name/ftm                  /ftm                     emmc    defaults                                                           defaults
/dev/block/bootdevice/by-name/boot                 /boot                    emmc    defaults                                                           defaults,slotselect
/dev/block/bootdevice/by-name/recovery             /recovery                emmc    defaults                                                           defaults,slotselect
/dev/block/bootdevice/by-name/dtbo                 /dtbo                    emmc    defaults                                                           defaults,slotselect
/dev/block/bootdevice/by-name/vbmeta               /vbmeta                  emmc    defaults                                                           defaults,slotselect
/dev/block/bootdevice/by-name/modemst1             /modemst1                emmc    defaults                                                           defaults
/dev/block/bootdevice/by-name/modemst2             /modemst2                emmc    defaults                                                           defaults
/dev/block/bootdevice/by-name/fsg                  /fsg                     emmc    defaults                                                           defaults
/devices/platform/soc/8804000.sdhci/mmc_host*      /external_sd             auto    defaults                                                           voldmanaged=external_sd:auto
/devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*    /usb_otg                 auto    defaults                                                           voldmanaged=usb:auto
