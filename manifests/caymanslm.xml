<?xml version="1.0" encoding="UTF-8"?>
<!--
  OrangeFox fox_14.1 local manifest for caymanslm (LG Velvet 4G, LM-G910EMW).

  Strategy: self-contained OrangeFox device tree with the kernel built from
  LineageOS source. We do NOT sync device/lge/sdm845-common (its BoardConfig
  pulls in LineageOS/CAF-only sepolicy + matrix repos that the TWRP manifest
  lacks); the device tree bakes in the validated values instead.

  All external projects are PINNED to reviewed revisions (lineage-22.2 heads
  captured 2026-07-21). Bump deliberately, never float.

  NOTE: no clone-depth on pinned projects — a shallow clone cannot fetch a
  specific SHA once the branch tip advances past it.

  NOTE: no <remove-project> prunes here — project names differ across manifest
  branches and a remove of a nonexistent project aborts `repo sync`. Disk space
  is handled by the workflow's aggressive root cleanup + pre-build capacity gate.

  NOTE: the TheMuppets proprietary_vendor_lge_* repos are intentionally NOT
  synced. This tree bundles its own hand-selected, ELF-verified decrypt blob set
  and does not inherit the LineageOS common tree, so those large repos were dead
  weight (disk + sync-failure risk) with no build dependency. Re-add only if a
  concrete build/source dependency on them is established.
-->
<manifest>
    <remote name="los" fetch="https://github.com/LineageOS" />

    <!-- Kernel source (built in-tree via TARGET_KERNEL_SOURCE).
         upstream= names the branch that contains the pinned SHA so that
         `repo sync -c` can fetch a bare revision deterministically (without it,
         a shallow -c sync of a bare SHA is repo-version-dependent). -->
    <project name="android_kernel_lge_sdm845"
             path="kernel/lge/sdm845"
             remote="los"
             revision="efa8458f79dffeb380d43b38b9403407f87d9f05"
             upstream="refs/heads/lineage-22.2" />

    <!-- No upstream-repo overrides. All caymanslm fixes to upstream repos
         (including system/vold's FBE decrypt) live as whole-file overlays in
         overlay/ and are applied to the tree by apply-fixes.sh after repo sync. -->
</manifest>
